classDiagram
    class Owner {
        +String name
        +int availableMinutes
        +List preferences
        +updatePreferences()
        +setAvailableTime()
    }

    class Pet {
        +String name
        +String species
        +int age
        +List careNeeds
        +updateInformation()
        +addCareNeed()
    }

    class CareTask {
        +String title
        +String description
        +int durationMinutes
        +String priority
        +String preferredTime
        +String status
        +String suggestionReason
        +String recurrence
        +Date recurrenceStartDate
        +Set completedDates
        +Pet pet (optional)
        +updateDetails()
        +acceptSuggestion()
        +markComplete(completedOn)
        +createNextOccurrence(completedOn)
        +isDueOn(scheduleDate)
        +markDenied()
    }

    class Scheduler {
        +Owner owner
        +List pets
        +List tasks
        +generateSchedule(scheduleDate, availableMinutes)
        +filterTasks(pet, status, petName)
        +sortByTime(tasks)
        +markTaskComplete(task, completedOn)
        +rankTasks(pet, status, scheduleDate)
        +detectConflicts(tasks)
        +getConflictWarnings(tasks)
        +filterTasksByAvailableTime(tasks, availableMinutes)
    }

    class DailySchedule {
        +Date date
        +int availableMinutes
        +List scheduledTasks
        +int totalMinutes
        +List conflicts
        +addTask(task)
        +removeTask()
        +explainPlan()
    }

    Owner "1" --> "0..*" Pet : cares for
    Owner "1" --> "0..*" CareTask : manages
    Pet "0..1" <-- "0..*" CareTask : assigned to
    Scheduler --> Owner : uses owner settings
    Scheduler --> Pet : checks care needs
    Scheduler --> CareTask : ranks and filters
    Scheduler --> DailySchedule : creates
    DailySchedule "1" o-- "0..*" CareTask : stores tasks added with addTask
